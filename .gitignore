# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
build/
dist/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Virtual envs ---
.venv/
.venv-*/
.reference-deps/
venv/
env/
.env

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# --- Claude Code workspace ---
.claude/

# --- Local user config ---
# Unanchored so the rule applies to every project subtree.
**/configs/*.local.yaml

# --- Inference artifacts ---
inference_result/
inference_result_diffusers/
inference_result_*/
conditioning_cache/reference_diffusers_compare/
outputs/
logs/
runs/
tmp/
*.log
*.pid

# --- Model weights / large binaries ---
# Checkpoint files are downloaded separately; do not commit.
# Unanchored so both echo_longvideo/ and echo_wm/ are covered.
**/checkpoints/*
!**/checkpoints/.gitkeep
!**/checkpoints/README.md
!**/checkpoints/*.manifest.json
*.safetensors
*.pt
*.bin
*.ckpt
*.onnx

# --- Generated media ---
*.mp4
*.mov
*.avi
*.mkv
*.wav
*.flac
*.mp3

# --- Misc ---
*.tmp
*.bak
node_modules/

